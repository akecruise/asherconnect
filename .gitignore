# ── ของลับ: ห้ามเข้า git เด็ดขาด ──────────────────────────────────────────
# .env* ครอบทั้ง .env.local, .env.bak-* ที่เคยหลุดออกมาจากการทดลอง
.env*
!.env.example
channels.json
channels.json.*
.secrets-archive/
.sessions/

# ── ของชั่วคราว ─────────────────────────────────────────────────────────
*.bak
*.bak-*
*.bak[0-9]
test-results/
node_modules/
start-error.txt

# ช่องส่งมอบงานระหว่าง agent — เป็นของชั่วคราวของเครื่องที่รันอยู่ ไม่ใช่ของโปรเจกต์
.handoff/
.health-audit/
deploy-*.tar.gz
deploy-files.txt
deploy-sha-local.txt
channels_*.json

# ── ไฟล์ข้อมูลนำเข้า ─────────────────────────────────────────────────────
# สเปรดชีตต้นทางของ quick-replies เป็น "ข้อมูลที่เอาเข้า" ไม่ใช่ซอร์สของโปรแกรม
# และเป็น binary — เข้า git แล้วอยู่ในประวัติถาวรและ diff ไม่ได้
# ของที่ต้องอยู่ใน git คือผลลัพธ์หลัง import (sql/) ไม่ใช่ไฟล์ต้นทาง
imports/
