# ตัวอย่างค่าตั้งค่าของ asher-connect — ไฟล์นี้เข้า git ได้ ห้ามมีค่าจริง
# ใช้งานจริง: คัดลอกเป็น .env แล้วเติมค่า (.env ถูก .gitignore ไว้แล้ว)

CONNECT_PUBLIC_URL=http://localhost:3200
SUPABASE_URL=http://supabase-envoy:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# โหมดเงา: รับเข้าอย่างเดียว ไม่ส่งออกหาลูกค้า
CONNECT_SHADOW_MODE=true

# ไม่มีชั้นล็อกอิน — ทั้งบริการทำงานในนามบัญชีนี้บัญชีเดียว
# ใครเปิดหน้าเว็บได้ = ใช้สิทธิ์ของบัญชีนี้ได้ ด่านที่เหลือคือพอร์ตผูกไว้ที่ 127.0.0.1 เท่านั้น
CONNECT_ACCOUNT_EMAIL=admin.test@asher.local
CONNECT_ACCOUNT_PASSWORD=

# ทะเบียน Edge Function ที่หน้าจอเรียกได้ ชื่อคั่นด้วยจุลภาค
# ย้ายโปรแกรมลงมาได้ทีละตัว = เติมชื่อตรงนี้ทีละชื่อ ไม่ต้องแก้โค้ด
# หน้าจอเรียกด้วย action ชื่อ fn:<ชื่อฟังก์ชัน>
CONNECT_EDGE_FUNCTIONS=

# ═══════════════════════════════════════════════════════════════════════════
# ใส่ค่าตรงนี้ — ช่องที่เว้นไว้ให้เติมเอง
#
# ★ ไฟล์นี้อยู่ใน .gitignore แล้ว ค่าที่ใส่จะไม่เข้า git
# ★ แก้ไฟล์นี้แล้วต้อง  docker compose ... up -d   (restart เฉย ๆ ไม่โหลดใหม่)
# ═══════════════════════════════════════════════════════════════════════════

# ── คีย์ของ Claude ────────────────────────────────────────────────────────
# ใช้ตอนบอทคิดคำตอบ (generate) และถอดหมวดคำถาม (classify)
#
# ใส่แล้วยังไม่เสียเงินทันที — สวิตช์บอทปิดอยู่เป็นค่าเริ่มต้น
# ต้องไปกดปุ่ม "บอทปิด · กดเพื่อเปิด" บนหน้าเว็บเองก่อน จึงจะเริ่มเรียกจริง
ANTHROPIC_API_KEY=

# ── ปลายทางของการแจ้งทีม ──────────────────────────────────────────────────
# ไม่ใส่ = ช่องทางนั้นเงียบไปเฉย ๆ ไม่ทำให้งานล้ม
# ตอนนี้งานแจ้งถูกข้ามด้วยเหตุผล no_notify_target เพราะยังไม่มีปลายทางสักทาง

# กลุ่ม LINE ที่ทีมเฝ้าอยู่ — ใช้ทุกครั้งที่มีคนทัก
# LINE_NOTIFY_GROUP_ID หาได้โดยเชิญบอทเข้ากลุ่มแล้วพิมพ์ "ไอดีกลุ่ม" (Phase 6)
LINE_NOTIFY_GROUP_ID=
LINE_NOTIFY_TOKEN=

# Telegram กับอีเมล — ยิงเฉพาะตอนลูกค้าให้เบอร์หรือ LINE มา
# (ตามพฤติกรรมเดิมของ fanout: สองทางนี้ไว้สะกิดคนที่ไม่ได้เฝ้าจอ ไม่ใช่รายงานทุกข้อความ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=onboarding@resend.dev
